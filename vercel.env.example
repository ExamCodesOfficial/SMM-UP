# SMM UP — complete Vercel environment-variable template
# Add these in Vercel Project Settings -> Environment Variables.
# Scope production values to Production, and use separate Preview/Development values.
# Never commit real credentials. Generate every *_SECRET / *_HASH_SECRET independently.

# Runtime
NODE_ENV=production
PUBLIC_SITE_URL=https://smmup.co.in
# Legacy fallback only; PUBLIC_SITE_URL takes precedence.
SITE_URL=https://smmup.co.in

# MongoDB Atlas (transactions require a replica set / Atlas cluster)
MONGODB_URI=
DATABASE_NAME=smm_up_db

# Authentication, opaque sessions, metadata pseudonymisation and abuse controls
# Use independent cryptographically random values of at least 32 characters.
JWT_SECRET=
SESSION_METADATA_HASH_SECRET=
RATE_LIMIT_HASH_SECRET=
API_ACTIVITY_HASH_SECRET=
# Required by /api/cron/status-sync; use at least 32 random characters.
CRON_SECRET=

# Transactional email (Resend)
RESEND_API_KEY=
# Example format: SMM UP <security@your-verified-domain.example>
EMAIL_FROM=
# Optional global override in minutes; leave blank to use purpose-specific defaults.
EMAIL_TOKEN_TTL_MINUTES=

# Owner-issued temporary-password recovery
TEMP_PASSWORD_TTL_MINUTES=180
# Allowed values: 1 or 2
TEMP_PASSWORD_MAX_USES=2
TEMP_PASSWORD_SESSION_TTL_MINUTES=15

# Named reseller API keys
API_KEY_CREATION_FEE_INR=29
API_KEY_MAX_IDENTITIES=10

# Upstream SMM supplier and private pricing
# PANEL_URL must be HTTPS in production. Never expose these as VITE_* variables.
PANEL_URL=
PANEL_KEY=
# Private positive numeric multipliers. Keep actual values only in Vercel.
TIER1_MARKUP=
TIER2_MARKUP=

# Direct UPI
UPI_VPA=
UPI_MERCHANT_NAME=SMM UP
DIRECT_UPI_PENDING_TTL_MINUTES=30
DIRECT_UPI_MAX_AMOUNT_INR=100000
# Exact website verification may recover a recently expired request for this many hours (1-72).
DIRECT_UPI_LATE_VERIFICATION_HOURS=24

# Website-side IMAP receipt verification
FAMPAY_EMAIL=
# Gmail app password; never use or store the mailbox's normal password.
FAMPAY_APP_PASSWORD=
# One exact trusted sender mailbox, not a domain fragment.
FAMPAY_SENDER_FILTER=no-reply@famapp.in
# Recent trusted-sender receipts inspected when Gmail BODY search misses base64 MIME content (10-100).
DIRECT_UPI_IMAP_SCAN_LIMIT=40

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Must match the key prefix: test for rzp_test_*, live for rzp_live_*.
RAZORPAY_MODE=live
# Keep false in production unless intentionally testing with an isolated database.
RAZORPAY_ALLOW_TEST_WALLET_CREDIT=false
RAZORPAY_MAX_DEPOSIT_INR=100000

# ─────────────────────────────────────────────────────────────────────────────
# Payment method toggles (two layers: this env baseline, then a MongoDB
# runtime override the owner bot can change instantly with no redeploy).
# A method that is OFF is hidden from the website entirely.
# Accepted values: 1/true/yes/on and 0/false/no/off.
# ─────────────────────────────────────────────────────────────────────────────
PAYMENT_METHOD_DIRECT_UPI_ENABLED=false
PAYMENT_METHOD_FAMGATEWAY_UPI_ENABLED=true
PAYMENT_METHOD_OXAPAY_CRYPTO_ENABLED=true
PAYMENT_METHOD_RAZORPAY_ENABLED=false

# ─────────────────────────────────────────────────────────────────────────────
# UPI Automatic (FamGateway) — https://famgateway.in
# ─────────────────────────────────────────────────────────────────────────────
# Merchant API key from https://famgateway.in/api-keys.php (sent as X-Api-Key).
FAMGATEWAY_API_KEY=
# The connected UPI VPA that receives the payment.
FAMGATEWAY_UPI_VPA=aryanok@fam
FAMGATEWAY_MIN_DEPOSIT_INR=10
FAMGATEWAY_MAX_DEPOSIT_INR=100000
# How long a payment QR stays valid (5-30 minutes).
FAMGATEWAY_ORDER_LIFETIME_MINUTES=5

# ─────────────────────────────────────────────────────────────────────────────
# Crypto (OxaPay) — https://app.oxapay.com/dashboard
# ─────────────────────────────────────────────────────────────────────────────
# Merchant API key from the OxaPay dashboard.
OXAPAY_MERCHANT_API_KEY=
# live or sandbox.
OXAPAY_MODE=live
# The fiat currency the invoice is raised in: USD or INR.
# USD means the customer picks $1-$500 and the wallet is credited the INR
# equivalent at the rate locked when the invoice was created.
OXAPAY_INVOICE_CURRENCY=USD
# INR value of 1 USD. Change this from the owner bot at any time.
OXAPAY_USD_TO_INR_RATE=98
OXAPAY_MIN_DEPOSIT_USD=1
OXAPAY_MAX_DEPOSIT_USD=500
# 1 = the customer pays the crypto network fee, 0 = the merchant absorbs it.
OXAPAY_FEE_PAID_BY_PAYER=1
# Under-payment coverage percentage (0-60).
OXAPAY_UNDER_PAID_COVERAGE=5
# Invoice lifetime in minutes (15-2880).
OXAPAY_INVOICE_LIFETIME_MINUTES=60
# Keep false in production: a sandbox invoice must never fund a live wallet.
OXAPAY_ALLOW_SANDBOX_CREDIT=false

# ─────────────────────────────────────────────────────────────────────────────
# Internal bot -> website channel
# Shared HMAC secret (>= 32 characters) used by the Telegram admin bot to
# reach /api/internal/reconcile. Rotate by setting INTERNAL_API_SECRET_PREVIOUS
# to the old value for the length of one rotation.
# ─────────────────────────────────────────────────────────────────────────────
INTERNAL_API_SECRET=
INTERNAL_API_SECRET_PREVIOUS=

# Website-to-owner Telegram operational alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
